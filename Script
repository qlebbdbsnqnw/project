-- [ЛОГИКА СЛАЙДЕРА (ПОЛОСКИ)]
local sliderDragging = false
local MIN_MULTIPLIER = 1.0
local MAX_MULTIPLIER = 50.0

local function updateSlider(input)
    local trackWidth = SliderTrack.AbsoluteSize.X
    local mouseX = input.Position.X
    local trackLeft = SliderTrack.AbsolutePosition.X
    
    local percentage = math.clamp((mouseX - trackLeft) / trackWidth, 0, 1)
    
    -- Вычисляем новый множитель с шагом 0.5
    local rawVal = MIN_MULTIPLIER + (MAX_MULTIPLIER - MIN_MULTIPLIER) * percentage
    hitboxSizeMultiplier = math.floor(rawVal * 2 + 0.5) / 2
    
    -- Ограничиваем корректность
    hitboxSizeMultiplier = math.clamp(hitboxSizeMultiplier, MIN_MULTIPLIER, MAX_MULTIPLIER)
    
    -- Визуальное перемещение ползунка
    local visualPercent = (hitboxSizeMultiplier - MIN_MULTIPLIER) / (MAX_MULTIPLIER - MIN_MULTIPLIER)
    SliderKnob.Position = UDim2.new(visualPercent, -8, 0.5, -8)
    SliderFill.Size = UDim2.new(visualPercent, 0, 1, 0)
    
    -- Обновляем текст
    SizeLabel.Text = string.format("РАЗМЕР ХИТБОКСА: %.1fx", hitboxSizeMultiplier)
    
    -- Моментально применяем
    if isHitboxEnabled then
        task.spawn(scanDrones)
    end
end

-- Инициализация стартового положения слайдера (5.0x)
local function initSlider()
    local startPercent = (hitboxSizeMultiplier - MIN_MULTIPLIER) / (MAX_MULTIPLIER - MIN_MULTIPLIER)
    SliderKnob.Position = UDim2.new(startPercent, -8, 0.5, -8)
    SliderFill.Size = UDim2.new(startPercent, 0, 1, 0)
    SizeLabel.Text = string.format("РАЗМЕР ХИТБОКСА: %.1fx", hitboxSizeMultiplier)
end
initSlider()

SliderKnob.InputBegan:Connect(function(input)
    if input.UserInputType == Enum.UserInputType.MouseButton1 or input.UserInputType == Enum.UserInputType.Touch then
        sliderDragging = true
        TweenService:Create(KnobStroke, TweenInfo.new(0.15), {Color = Color3.fromRGB(100, 200, 255), Thickness = 3}):Play()
    end
end)

UserInputService.InputEnded:Connect(function(input)
    if input.UserInputType == Enum.UserInputType.MouseButton1 or input.UserInputType == Enum.UserInputType.Touch then
        if sliderDragging then
            sliderDragging = false
            TweenService:Create(KnobStroke, TweenInfo.new(0.15), {Color = Color3.fromRGB(0, 140, 255), Thickness = 2}):Play()
        end
    end
end)

UserInputService.InputChanged:Connect(function(input)
    if sliderDragging and (input.UserInputType == Enum.UserInputType.MouseMovement or input.UserInputType == Enum.UserInputType.Touch) then
        updateSlider(input)
    end
end)

-- Быстрый клик по дорожке слайдера
SliderTrack.InputBegan:Connect(function(input)
    if input.UserInputType == Enum.UserInputType.MouseButton1 or input.UserInputType == Enum.UserInputType.Touch then
        sliderDragging = true
        updateSlider(input)
    end
end)



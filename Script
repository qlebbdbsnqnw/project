local isEnabled = false          -- Состояние ESP
local isHitboxEnabled = false    -- Состояние Хитбокс-экспандера
local isVisualEnabled = false    -- Показывать хитбокс визуально (галочка)
local hitboxSizeMultiplier = 5.0  -- Множитель размера хитбокса (от 1.0 до 50.0)
local isRunning = true

local activeHighlights = {}      -- [Модель] = {hl = Highlight, gui = BillboardGui}
local expandedHitboxes = {}      -- [Модель] = {targetPart = BasePart, originalSize = Vector3, originalTransparency = number, originalCanCollide = boolean, originalColor = Color3, visualClone = Instance}

local function isTargetDrone(instance)
    if instance:IsA("Model") then
        local name = string.lower(instance.Name)
        return name == "fpvdrone"
    end
    return false
end

-- Поиск владельца по дистанции
local function getClosestPlayer(droneModel)
    local dPrimary = droneModel.PrimaryPart or droneModel:FindFirstChildWhichIsA("BasePart")
    if not dPrimary then return "Unknown" end
    
    local closestPlayer = nil
    local shortestDistance = MAX_OWNER_DISTANCE
    
    for _, p in ipairs(Players:GetPlayers()) do
        if p.Character and p.Character:FindFirstChild("HumanoidRootPart") then
            local pPart = p.Character.HumanoidRootPart
            local distance = (dPrimary.Position - pPart.Position).Magnitude
            
            if distance < shortestDistance then
                shortestDistance = distance
                closestPlayer = p
            end
        end
    end
    
    return closestPlayer and closestPlayer.Name or "Unknown Owner"
end

-- Создание 3D-текста над дроном
local function createDroneTag(model, ownerName)
    local targetPart = model.PrimaryPart or model:FindFirstChildWhichIsA("BasePart")
    if not targetPart then return nil end

    local bbGui = Instance.new("BillboardGui")
    bbGui.Name = "DroneOwnerTag"
    bbGui.Size = UDim2.new(4, 0, 1, 0)
    bbGui.AlwaysOnTop = true
    bbGui.ResetOnSpawn = false
    bbGui.ExtentsOffset = Vector3.new(0, 3, 0)
    bbGui.Parent = targetPart

    local textLabel = Instance.new("TextLabel")
    textLabel.Size = UDim2.new(1, 0, 1, 0)
    textLabel.BackgroundTransparency = 1
    textLabel.Text = ownerName
    textLabel.TextColor3 = Color3.fromRGB(255, 255, 255)
    textLabel.TextScaled = true
    textLabel.Font = Enum.Font.GothamBold
    textLabel.TextStrokeTransparency = 0.2
    textLabel.TextStrokeColor3 = Color3.fromRGB(0, 0, 0)
    textLabel.Parent = bbGui

    local uiSizeConstraint = Instance.new("UISizeConstraint")
    uiSizeConstraint.MaxSize = Vector2.new(150, 35)
    uiSizeConstraint.Parent = textLabel

    return bbGui
end

local function removeDroneTracking(model)
    if activeHighlights[model] then
        if activeHighlights[model].hl then activeHighlights[model].hl:Destroy() end
        if activeHighlights[model].gui then activeHighlights[model].gui:Destroy() end
        activeHighlights[model] = nil
    end
end

-- Функция увеличения хитбокса
local function expandHitbox(model, multiplier)
    local base2 = model:FindFirstChild("Base2", true) -- Рекурсивный поиск Base2
    if not base2 then return end

    -- Определяем физическую деталь, которую будем расширять
    local targetPart = nil
    if base2:IsA("BasePart") then
        targetPart = base2
    elseif base2:IsA("SpecialMesh") or base2:IsA("DataModelMesh") then
        targetPart = base2.Parent
    end

    if not targetPart or not targetPart:IsA("BasePart") then return end

    -- Если хитбокс уже расширен для этой модели
    if expandedHitboxes[model] then
        -- Обновляем физический размер и визуальный рендеринг при изменении на лету
        targetPart.Size = expandedHitboxes[model].originalSize * multiplier
        if isVisualEnabled then
            targetPart.Transparency = 0.7
            targetPart.Color = Color3.fromRGB(255, 50, 50) -- Полупрозрачный красный куб-хитбокс
        else
            targetPart.Transparency = 1 -- Полностью скрытый хитбокс
            targetPart.Color = expandedHitboxes[model].originalColor
        end
        return
    end

    -- Сохраняем оригинальные свойства
    local originalSize = targetPart.Size
    local originalTransparency = targetPart.Transparency
    local originalCanCollide = targetPart.CanCollide
    local originalColor = targetPart.Color

    -- Создаем визуальный клон, который будет летать без физики на месте старого размера
    local visualClone = targetPart:Clone()
    visualClone.Name = "Base2_VisualClone"
    visualClone.Size = originalSize
    visualClone.CanCollide = false
    visualClone.CanTouch = false
    visualClone.CanQuery = false -- Полностью исключаем визуальный клон из рейкастов выстрелов
    visualClone.Transparency = originalTransparency
    
    -- Очищаем скрипты внутри клона, если они там есть
    for _, child in ipairs(visualClone:GetDescendants()) do
        if child:IsA("LuaSourceContainer") then
            child:Destroy()
        end
    end
    visualClone.Parent = model

    -- Жестко привариваем клон к исходному Base2
    local weld = Instance.new("WeldConstraint")
    weld.Name = "VisualWeld"
    weld.Part0 = targetPart
    weld.Part1 = visualClone
    weld.Parent = visualClone

    visualClone.CFrame = targetPart.CFrame

    -- Изменяем физическую деталь
    targetPart.Size = originalSize * multiplier
    targetPart.CanCollide = false -- Отключаем коллизии со стенами
    
    if isVisualEnabled then
        targetPart.Transparency = 0.7
        targetPart.Color = Color3.fromRGB(255, 50, 50) -- Красный полупрозрачный вид
    else
        targetPart.Transparency = 1 -- Делаем хитбокс полностью невидимым
    end

    expandedHitboxes[model] = {
        targetPart = targetPart,
        originalSize = originalSize,
        originalTransparency = originalTransparency,
        originalCanCollide = originalCanCollide,
        originalColor = originalColor,
        visualClone = visualClone
    }
end

-- Восстановление дефолтных настроек хитбокса
local function restoreHitbox(model)
    local data = expandedHitboxes[model]
    if data then
        if data.targetPart and data.targetPart.Parent then
            data.targetPart.Size = data.originalSize
            data.targetPart.Transparency = data.originalTransparency
            data.targetPart.CanCollide = data.originalCanCollide
            data.targetPart.Color = data.originalColor
        end
        if data.visualClone then
            data.visualClone:Destroy()
        end
        expandedHitboxes[model] = nil
    end
end

local function clearAllHighlights()
    for model, data in pairs(activeHighlights) do
        if data.hl then data.hl:Destroy() end
        if data.gui then data.gui:Destroy() end
    end
    table.clear(activeHighlights)
end

local function restoreAllHitboxes()
    for model, _ in pairs(expandedHitboxes) do
        restoreHitbox(model)
    end
    table.clear(expandedHitboxes)
end

-- Основная функция сканированияWorkspace
local function scanDrones()
    if not isRunning then return end

    local currentDrones = {}
    local droneCount = 0

    for _, child in ipairs(Workspace:GetDescendants()) do
        if isTargetDrone(child) then
            currentDrones[child] = true
            droneCount = droneCount + 1
            
            -- Логика ESP
            if isEnabled then
                if not activeHighlights[child] then
                    local ownerName = getClosestPlayer(child)
                    
                    -- Белая подсветка
                    local hl = Instance.new("Highlight")
                    hl.Name = "DroneESP"
                    hl.FillColor = Color3.fromRGB(255, 255, 255)
                    hl.FillTransparency = 0.5
                    hl.OutlineColor = Color3.fromRGB(255, 255, 255)
                    hl.OutlineTransparency = 0
                    hl.DepthMode = Enum.HighlightDepthMode.AlwaysOnTop
                    hl.Parent = child
                    
                    local tagGui = createDroneTag(child, ownerName)
                    activeHighlights[child] = {hl = hl, gui = tagGui}
                end
            else
                removeDroneTracking(child)
            end

            -- Логика Хитбоксов
            if isHitboxEnabled then
                expandHitbox(child, hitboxSizeMultiplier)
            else
                restoreHitbox(child)
            end
        end
    end

    -- Удаление трекинга и восстановление размеров для исчезнувших/сломавшихся дронов
    for model, _ in pairs(activeHighlights) do
        if not currentDrones[model] or not model.Parent then
            removeDroneTracking(model)
        end
    end

    for model, _ in pairs(expandedHitboxes) do
        if not currentDrones[model] or not model.Parent then
            restoreHitbox(model)
        end
    end

    -- Подсчет активных измененных хитбоксов
    local expCount = 0
    for _ in pairs(expandedHitboxes) do
        expCount = expCount + 1
    end

    StatusText.Text = "Дронов в полете: " .. tostring(droneCount) .. " | Изменено: " .. tostring(expCount)
end

local function safelyCall(func)
    local success, err = pcall(func)
    if not success then
        warn("Error in tracker scan loop: " .. tostring(err))
    end
end

-- Фоновый поток сканирования
task.spawn(function()
    while isRunning do
        safelyCall(scanDrones)
        task.wait(1) -- Проверяем мир каждую секунду
    end
end)

